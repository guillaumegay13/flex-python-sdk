{
  "mcpServers": {
    "flex": {
      "comment": "Example configuration for Claude Desktop. Copy relevant section to your claude_desktop_config.json",
      "comment2": "Location: macOS: ~/Library/Application Support/Claude/claude_desktop_config.json",
      "comment3": "Location: Windows: %APPDATA%\\Claude\\claude_desktop_config.json",
      
      "_option1_installed_package": {
        "command": "flex-mcp",
        "env": {
          "FLEX_ENV_URL": "https://your-flex-instance.com/api",
          "FLEX_ENV_USERNAME": "your-username",
          "FLEX_ENV_PASSWORD": "your-password"
        }
      },
      
      "_option2_python_module": {
        "command": "python",
        "args": ["-m", "flex_mcp_server"],
        "env": {
          "FLEX_ENV_URL": "https://your-flex-instance.com/api",
          "FLEX_ENV_USERNAME": "your-username",
          "FLEX_ENV_PASSWORD": "your-password"
        }
      },
      
      "_option3_development_mode": {
        "command": "python",
        "args": ["-m", "flex_mcp_server"],
        "cwd": "/path/to/flex-python-sdk/mcp-server",
        "env": {
          "PYTHONPATH": "/path/to/flex-python-sdk",
          "FLEX_ENV_URL": "https://your-flex-instance.com/api",
          "FLEX_ENV_USERNAME": "your-username",
          "FLEX_ENV_PASSWORD": "your-password"
        }
      }
    }
  }
}